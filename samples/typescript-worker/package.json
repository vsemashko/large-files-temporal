{
  "name": "temporal-large-files-ts-worker",
  "version": "1.0.0",
  "description": "TypeScript worker sample for Temporal with large files codec",
  "main": "lib/worker.js",
  "scripts": {
    "build": "tsc",
    "start": "node lib/worker.js",
    "dev": "ts-node src/worker.ts",
    "client": "ts-node src/client.ts",
    "start.watch": "nodemon src/worker.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@temporalio/activity": "^1.10.0",
    "@temporalio/client": "^1.10.0",
    "@temporalio/worker": "^1.13.2",
    "@temporalio/workflow": "^1.10.0",
    "@temporalio/common": "^1.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0"
  }
}
