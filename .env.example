# Temporal Configuration
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Codec Server Configuration
CODEC_GRPC_PORT=9090
CODEC_HTTP_PORT=8080
PAYLOAD_SIZE_THRESHOLD_BYTES=2097152  # 2MB (Temporal has 4MB limit)
COMPRESSION_ENABLED=true

# S3 Configuration
S3_BUCKET=temporal-large-payloads
S3_REGION=us-east-1
S3_ENDPOINT=  # Leave empty for AWS, set for LocalStack/MinIO (e.g., http://localhost:4566)

# AWS Credentials (prefer IAM roles in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cleanup Configuration
CLEANUP_ENABLED=true
CLEANUP_SCHEDULE=0 2 * * *  # Daily at 2 AM (cron format)
CLEANUP_GRACE_PERIOD_DAYS=7
CHECK_ARCHIVE_BEFORE_DELETE=true
MAX_WORKFLOWS_PER_BATCH=100

# Worker Configuration
TASK_QUEUE=large-files-task-queue

# Logging
LOG_LEVEL=info
